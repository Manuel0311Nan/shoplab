generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hogar {
  id        String   @id @default(uuid(7)) @db.Uuid
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  miembros      MiembroHogar[]
  listas        ShoppingList[] // ← nuevo
  shoppingItems ShoppingItem[]
}

model Usuario {
  id            String   @id @default(uuid(7)) @db.Uuid
  email         String   @unique
  nombre        String
  /// Lo exige Better Auth. Se usará con la verificación de email (vista 6).
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hogares        MiembroHogar[]
  itemsComprados ShoppingItem[]
  sesiones       Session[]
  cuentas        Account[]
}

// ─── Identity (tablas de Better Auth) ──────────────────────────────────────
// Sin hogarId: no van en TENANT_MODELS. Nombres en inglés porque son tablas
// de la librería, no de nuestro dominio. Ids UUIDv7 generados con newId().

/// Una fila por dispositivo con sesión abierta. Borrarla cierra esa sesión.
model Session {
  id        String   @id @db.Uuid
  usuarioId String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

/// Forma de entrar de un usuario. Con email y contraseña, `password` guarda el hash (scrypt).
model Account {
  id                    String    @id @db.Uuid
  usuarioId             String    @db.Uuid
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

/// Tokens de un solo uso: verificar email y restablecer contraseña (vista 6).
model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Contadores del límite de peticiones, compartidos entre instancias de Vercel.
model RateLimit {
  id          String @id @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model MiembroHogar {
  hogarId   String   @db.Uuid
  usuarioId String   @db.Uuid
  createdAt DateTime @default(now())

  hogar   Hogar   @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([hogarId, usuarioId])
}

enum Unidad {
  unidad
  g
  kg
  ml
  l
}

model ShoppingList {
  id          String         @id @default(uuid(7)) @db.Uuid
  hogarId     String         @db.Uuid
  nombre      String
  archivadaAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  hogar       Hogar          @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  items       ShoppingItem[]

  @@index([hogarId, updatedAt])
  /// Mis listas: activas por updatedAt y archivadas por archivadaAt.
  @@index([hogarId, archivadaAt, updatedAt])
}

model ShoppingItem {
  id             String        @id @default(uuid(7)) @db.Uuid
  hogarId        String        @db.Uuid
  listaId        String        @db.Uuid
  nombre         String
  ingredientId   String?       @db.Uuid
  /// Producto de la lista base elegido al autocompletar (null si se escribió a mano).
  productoBaseId String?       @db.Uuid
  cantidadValor  Decimal       @db.Decimal(10, 3)
  cantidadUnidad Unidad
  nota           String?
  compradoAt     DateTime?
  compradoPorId  String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  hogar          Hogar         @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  lista          ShoppingList  @relation(fields: [listaId], references: [id], onDelete: Cascade)
  compradoPor    Usuario?      @relation(fields: [compradoPorId], references: [id], onDelete: SetNull)
  productoBase   ProductoBase? @relation(fields: [productoBaseId], references: [id], onDelete: SetNull)

  @@index([listaId, deletedAt])
  @@index([hogarId, updatedAt])
}

// ─── Catalog ────────────────────────────────────────────────────────────────
// Lista base global (sin hogarId: no va en TENANT_MODELS). La rellena el seed.

enum CategoriaProducto {
  frutas
  verduras
  vacuno
  pollo_pavo
  cerdo_cordero
  charcuteria
  pescado
  lacteos_huevos
  panaderia
  despensa
  especias
  bebidas
  congelados
  limpieza
  higiene
}

/// Producto de la lista base para autocompletar.
model ProductoBase {
  id                String            @id @db.Uuid
  nombre            String
  /// normalizarNombre(nombre): sin tildes, minúsculas, espacios simples. Clave del seed.
  nombreNormalizado String            @unique
  categoria         CategoriaProducto
  unidadPorDefecto  Unidad
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items ShoppingItem[]
}
