generator client {
    provider = "prisma-client"
    output = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Hogar {
  id        String   @id @default(uuid(7)) @db.Uuid
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  miembros MiembroHogar[]
  listas        ShoppingList[]   // ← nuevo
  shoppingItems ShoppingItem[] 
}

model Usuario {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @unique
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hogares MiembroHogar[]
  itemsComprados ShoppingItem[]

}

model MiembroHogar {
  hogarId   String   @db.Uuid
  usuarioId String   @db.Uuid
  createdAt DateTime @default(now())

  hogar   Hogar   @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([hogarId, usuarioId])
}

enum Unidad {
  unidad
  g
  kg
  ml
  l
}
model ShoppingList {
  id          String    @id @default(uuid(7)) @db.Uuid
  hogarId     String    @db.Uuid
  nombre      String
  archivadaAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  hogar Hogar          @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  items ShoppingItem[]
  @@index([hogarId, updatedAt])
}
model ShoppingItem {
  id             String    @id @default(uuid(7)) @db.Uuid
  hogarId        String    @db.Uuid
  listaId        String    @db.Uuid
  nombre         String
  ingredientId   String?   @db.Uuid
  cantidadValor  Decimal   @db.Decimal(10, 3)
  cantidadUnidad Unidad
  nota           String?
  compradoAt     DateTime?
  compradoPorId  String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  hogar       Hogar        @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  lista       ShoppingList @relation(fields: [listaId], references: [id], onDelete: Cascade)
  compradoPor Usuario?     @relation(fields: [compradoPorId], references: [id], onDelete: SetNull)
  @@index([listaId, deletedAt])
  @@index([hogarId, updatedAt])
}