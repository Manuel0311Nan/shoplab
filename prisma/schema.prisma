generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hogar {
  id        String   @id @default(uuid(7)) @db.Uuid
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  miembros              MiembroHogar[]
  listas                ShoppingList[] // ← nuevo
  shoppingItems         ShoppingItem[]
  productosRecordados   ProductoRecordado[]
  ubicaciones           Ubicacion[]
  inventario            InventoryItem[]
  movimientosDespensa   MovimientoDespensa[]
  packsRecordados       PackRecordado[]
  ubicacionesRecordadas UbicacionRecordada[]
  emojisProductos       EmojiProducto[]
}

model Usuario {
  id            String   @id @default(uuid(7)) @db.Uuid
  email         String   @unique
  nombre        String
  /// Lo exige Better Auth. Se usará con la verificación de email (vista 6).
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hogares             MiembroHogar[]
  itemsComprados      ShoppingItem[]
  sesiones            Session[]
  cuentas             Account[]
  movimientosDespensa MovimientoDespensa[]
}

// ─── Identity (tablas de Better Auth) ──────────────────────────────────────
// Sin hogarId: no van en TENANT_MODELS. Nombres en inglés porque son tablas
// de la librería, no de nuestro dominio. Ids UUIDv7 generados con newId().

/// Una fila por dispositivo con sesión abierta. Borrarla cierra esa sesión.
model Session {
  id        String   @id @db.Uuid
  usuarioId String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

/// Forma de entrar de un usuario. Con email y contraseña, `password` guarda el hash (scrypt).
model Account {
  id                    String    @id @db.Uuid
  usuarioId             String    @db.Uuid
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

/// Tokens de un solo uso: verificar email y restablecer contraseña (vista 6).
model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Contadores del límite de peticiones, compartidos entre instancias de Vercel.
model RateLimit {
  id          String @id @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model MiembroHogar {
  hogarId   String   @db.Uuid
  usuarioId String   @db.Uuid
  createdAt DateTime @default(now())

  hogar   Hogar   @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([hogarId, usuarioId])
}

enum Unidad {
  unidad
  g
  kg
  ml
  l
}

model ShoppingList {
  id          String         @id @default(uuid(7)) @db.Uuid
  hogarId     String         @db.Uuid
  nombre      String
  archivadaAt DateTime?
  /// La lista general del hogar: una por hogar. Enseña sus productos y los de todas las
  /// listas activas; no se archiva ni se borra y no cuenta para el límite de 15.
  general     Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  hogar       Hogar          @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  items       ShoppingItem[]

  @@index([hogarId, updatedAt])
  /// Mis listas: activas por updatedAt y archivadas por archivadaAt.
  @@index([hogarId, archivadaAt, updatedAt])
}

model ShoppingItem {
  id              String            @id @default(uuid(7)) @db.Uuid
  hogarId         String            @db.Uuid
  listaId         String            @db.Uuid
  nombre          String
  ingredientId    String?           @db.Uuid
  /// Producto de la lista base elegido al autocompletar (null si se escribió a mano).
  productoBaseId  String?           @db.Uuid
  /// Para agrupar la lista por el recorrido del súper.
  categoria       CategoriaProducto @default(otros)
  cantidadValor   Decimal           @db.Decimal(10, 3)
  cantidadUnidad  Unidad
  /// Si se añadió por packs: unidades de cada pack (la cantidad va siempre en unidades).
  unidadesPorPack Int?
  nota            String?
  compradoAt      DateTime?
  compradoPorId   String?           @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  hogar           Hogar             @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  lista           ShoppingList      @relation(fields: [listaId], references: [id], onDelete: Cascade)
  compradoPor     Usuario?          @relation(fields: [compradoPorId], references: [id], onDelete: SetNull)
  productoBase    ProductoBase?     @relation(fields: [productoBaseId], references: [id], onDelete: SetNull)

  @@index([listaId, deletedAt])
  @@index([hogarId, updatedAt])
}

/// Memoria del hogar: cómo compra cada producto por packs (de cuántas unidades y si la
/// última vez fue por packs). Propone el pack al añadirlo a una lista.
model PackRecordado {
  hogarId           String   @db.Uuid
  nombreNormalizado String
  unidadesPorPack   Int
  /// La última vez que se añadió en unidades, ¿fue por packs?
  enPack            Boolean
  updatedAt         DateTime @updatedAt

  hogar Hogar @relation(fields: [hogarId], references: [id], onDelete: Cascade)

  @@id([hogarId, nombreNormalizado])
}

// ─── Catalog ────────────────────────────────────────────────────────────────
// Lista base global (sin hogarId: no va en TENANT_MODELS). La rellena el seed.

enum CategoriaProducto {
  frutas
  verduras
  vacuno
  pollo_pavo
  cerdo_cordero
  charcuteria
  pescado
  lacteos_huevos
  panaderia
  despensa
  especias
  bebidas
  congelados
  limpieza
  higiene
  /// Lo que no se sabe clasificar. La lista base no lo usa.
  otros
}

/// Producto de la lista base para autocompletar.
model ProductoBase {
  id                String            @id @db.Uuid
  nombre            String
  /// normalizarNombre(nombre): sin tildes, minúsculas, espacios simples. Clave del seed.
  nombreNormalizado String            @unique
  categoria         CategoriaProducto
  unidadPorDefecto  Unidad
  /// Otros nombres ya normalizados (\"banana\" para Plátano): también vinculan.
  sinonimos         String[]          @default([])
  /// Excepción al aviso de «abierto» de su categoría (días hasta amarillo y hasta rojo).
  diasAvisoAmarillo Int?
  diasAvisoRojo     Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items      ShoppingItem[]
  inventario InventoryItem[]
}

/// Memoria del hogar para el texto libre: lo que ya escribió alguna vez, con su
/// categoría y unidad. Alimenta el autocompletado y clasifica sin preguntar.
model ProductoRecordado {
  hogarId           String            @db.Uuid
  nombreNormalizado String
  /// La última forma escrita, como se muestra en las sugerencias.
  nombre            String
  categoria         CategoriaProducto
  unidad            Unidad
  usos              Int               @default(1)
  ultimoUso         DateTime
  updatedAt         DateTime          @updatedAt

  hogar Hogar @relation(fields: [hogarId], references: [id], onDelete: Cascade)

  @@id([hogarId, nombreNormalizado])
}

/// Personalización del hogar: el emoji con que ve un producto (si no, el de por defecto
/// según el nombre, y si no hay, el icono de su categoría).
model EmojiProducto {
  hogarId           String   @db.Uuid
  nombreNormalizado String
  emoji             String
  updatedAt         DateTime @updatedAt

  hogar Hogar @relation(fields: [hogarId], references: [id], onDelete: Cascade)

  @@id([hogarId, nombreNormalizado])
}

// ─── Pantry ─────────────────────────────────────────────────────────────────

/// Qué conserva una ubicación: sirve para proponer dónde guardar cada categoría.
enum TipoUbicacion {
  frio
  congelado
  ambiente
}

/// Ver TipoMovimiento en domains/pantry/domain/inventory-item.ts.
enum TipoMovimiento {
  entrada
  consumo
  desecho
  ajuste
  baja
}

enum OrigenMovimiento {
  manual
  compra
}

/// Nevera, congelador, armario… configurables por hogar (D3, vista 3). Máximo 12.
model Ubicacion {
  id        String        @id @db.Uuid
  hogarId   String        @db.Uuid
  nombre    String
  tipo      TipoUbicacion
  /// Posición en la pantalla: 1, 2, 3…
  orden     Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  hogar      Hogar                @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  inventario InventoryItem[]
  recordadas UbicacionRecordada[]

  @@index([hogarId, deletedAt, orden])
}

/// Memoria del hogar: dónde se guardó cada producto la última vez que se eligió sitio.
/// Al borrar la ubicación pasa a la de destino (o se olvida y se propone por categoría).
model UbicacionRecordada {
  hogarId           String   @db.Uuid
  nombreNormalizado String
  ubicacionId       String   @db.Uuid
  updatedAt         DateTime @updatedAt

  hogar     Hogar     @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  ubicacion Ubicacion @relation(fields: [ubicacionId], references: [id], onDelete: Cascade)

  @@id([hogarId, nombreNormalizado])
  @@index([ubicacionId])
}

/// Una línea de la despensa: un producto en una ubicación con (o sin) caducidad.
model InventoryItem {
  id                   String            @id @db.Uuid
  hogarId              String            @db.Uuid
  nombre               String
  nombreNormalizado    String
  productoBaseId       String?           @db.Uuid
  categoria            CategoriaProducto
  ubicacionId          String            @db.Uuid
  cantidadValor        Decimal           @db.Decimal(10, 3)
  cantidadUnidad       Unidad
  /// Tras la última entrada o ajuste, en la misma unidad: base de "queda poco".
  cantidadReferencia   Decimal           @db.Decimal(10, 3)
  /// Un día, sin hora (D2: opcional).
  caducaEl             DateTime?         @db.Date
  /// Día en que se abrió el paquete (null: cerrado). Avisa para revisar, no caduca.
  abiertoEl            DateTime?         @db.Date
  /// Días abierto hasta amarillo y hasta rojo, fijados al abrirlo (producto o categoría).
  avisoAbiertoAmarillo Int?
  avisoAbiertoRojo     Int?
  /// Se guardó al terminar la compra sin elegir dónde: hay que colocarlo.
  porOrganizar         Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?

  hogar        Hogar                @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  ubicacion    Ubicacion            @relation(fields: [ubicacionId], references: [id], onDelete: Restrict)
  productoBase ProductoBase?        @relation(fields: [productoBaseId], references: [id], onDelete: SetNull)
  movimientos  MovimientoDespensa[]

  @@index([hogarId, deletedAt, ubicacionId])
  @@index([hogarId, deletedAt, caducaEl])
}

/// Cada cambio de cantidad de una línea (D7). No se edita ni se borra.
model MovimientoDespensa {
  id              String           @id @db.Uuid
  hogarId         String           @db.Uuid
  inventoryItemId String           @db.Uuid
  tipo            TipoMovimiento
  cantidadValor   Decimal          @db.Decimal(10, 3)
  cantidadUnidad  Unidad
  origen          OrigenMovimiento
  /// La lista de la que vino, si entró desde la compra. Sin FK: la lista puede borrarse.
  listaId         String?          @db.Uuid
  usuarioId       String?          @db.Uuid
  createdAt       DateTime         @default(now())

  hogar         Hogar         @relation(fields: [hogarId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  usuario       Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
}

/// Biblioteca de recetas (vista 4). Global: igual para todos los hogares. La siembra
/// `prisma/seed-recetas.ts` desde los lotes JSON de `domains/recipes/infrastructure/biblioteca`.
model Receta {
  id          String   @id @db.Uuid
  slug        String   @unique
  nombre      String
  descripcion String
  raciones    Int
  minutos     Int
  etiquetas   String[] @default([])
  pasos       String[]
  /// Huella del contenido del lote: si cambia, el seed reescribe la receta.
  huella      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredientes RecetaIngrediente[]
}

model RecetaIngrediente {
  id               String   @id @db.Uuid
  recetaId         String   @db.Uuid
  orden            Int
  nombre           String
  /// Productos de la lista base que lo cubren, en orden de preferencia. Sin FK (array).
  productosBaseIds String[] @db.Uuid
  cantidadValor    Decimal? @db.Decimal(10, 3)
  cantidadUnidad   Unidad?
  nota             String?
  basico           Boolean  @default(false)
  opcional         Boolean  @default(false)

  receta Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)

  @@unique([recetaId, orden])
}
