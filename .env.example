# Copia este archivo a .env.local y rellénalo con los datos de Neon.
# En Vercel las define la integración Neon↔Vercel.

# Conexión con pooling: la usa la app.
DATABASE_URL=""

# Conexión directa: la usa la CLI de Prisma (migraciones) desde prisma.config.ts.
DATABASE_URL_UNPOOLED=""

# Tests de integración (pnpm test:integration): una rama de Neon SOLO para tests,
# distinta de la de arriba. Los tests crean y borran datos.
TEST_DATABASE_URL=""
TEST_DATABASE_URL_UNPOOLED=""
